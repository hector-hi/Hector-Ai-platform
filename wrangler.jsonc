{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hector-ai-platform",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hector-ai-platform",
			"database_id": "1fea3ea5-6b6d-4ade-9e18-2757a2ca21be",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "hector-ai-platform-media",
		},
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	// Endereço público definitivo. Definido ANTES do setup para que as passkeys nasçam
	// presas a este domínio, e não ao workers.dev (doc EmDash: deployment/cloudflare.mdx,
	// "Custom domains"). Fica em vars, não em siteUrl, para não quebrar previews.
	"vars": {
		"EMDASH_SITE_URL": "https://hector-ai.space",
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans.
	"worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
